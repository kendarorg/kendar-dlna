# Defaults for docker-compose.yml. In Portainer paste or edit these in the stack's environment variables.
# Absolute HOST paths (Portainer clones the repository internally, relative paths would not work).
MUSIC_DIR=/srv/music
PLAYLISTS_DIR=/srv/kendar-dlna/playlists
CONFIG_DIR=/srv/kendar-dlna/config
DATA_DIR=/srv/kendar-dlna/data

# User/group the server runs as (owner of the files it writes: tags, settings.json, playlists, config, data).
# Use the owner of your music directory: id -u / id -g.
PUID=1000
PGID=1000
TZ=Europe/Rome

# Extra JVM options, for example -Xmx1g. Default heap: 70% of the container memory limit.
JAVA_OPTS=

# Image name and tag built on the host.
IMAGE_NAME=kendar-dlna
IMAGE_TAG=latest

# Shown on the admin page (optional).
GIT_COMMIT=unknown
BUILD_TIME=unknown
SKIP_TESTS=true
